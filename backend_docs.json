"components": {
"schemas": {
"AnalysisResult": {
"properties": {
"status": {
"type": "string",
"enum": [
"healthy",
"warning",
"critical"
],
"title": "Status"
},
"score": {
"type": "integer",
"maximum": 100,
"minimum": 0,
"title": "Score"
},
"anomalies": {
"items": {
"type": "string"
},
"type": "array",
"title": "Anomalies",
"default": []
},
"recommendations": {
"items": {
"type": "string"
},
"type": "array",
"title": "Recommendations",
"default": []
}
},
"type": "object",
"required": [
"status",
"score"
],
"title": "AnalysisResult"
},
"AnalyzeRequest": {
"properties": {
"motor_id": {
"type": "string",
"title": "Motor Id"
},
"readings": {
"additionalProperties": true,
"type": "object",
"title": "Readings"
}
},
"type": "object",
"required": [
"motor_id",
"readings"
],
"title": "AnalyzeRequest"
},
"AnalyzeResponse": {
"properties": {
"rule_status": {
"type": "string",
"title": "Rule Status"
},
"rule_score": {
"type": "integer",
"title": "Rule Score"
},
"ai_status": {
"type": "string",
"title": "Ai Status"
},
"explanation": {
"type": "string",
"title": "Explanation"
},
"recommendations": {
"items": {
"type": "string"
},
"type": "array",
"title": "Recommendations"
},
"follow_up_questions": {
"items": {
"type": "string"
},
"type": "array",
"title": "Follow Up Questions"
}
},
"type": "object",
"required": [
"rule_status",
"rule_score",
"ai_status",
"explanation",
"recommendations",
"follow_up_questions"
],
"title": "AnalyzeResponse"
},
"AssignSpecRequest": {
"properties": {
"spec_id": {
"type": "string",
"title": "Spec Id"
}
},
"type": "object",
"required": [
"spec_id"
],
"title": "AssignSpecRequest"
},
"AuditLogOut": {
"properties": {
"id": {
"type": "string",
"title": "Id"
},
"action": {
"type": "string",
"title": "Action"
},
"user_id": {
"type": "string",
"title": "User Id"
},
"timestamp": {
"type": "string",
"format": "date-time",
"title": "Timestamp"
},
"resource_type": {
"type": "string",
"title": "Resource Type"
},
"resource_id": {
"type": "string",
"title": "Resource Id"
},
"changes": {
"additionalProperties": true,
"type": "object",
"title": "Changes"
}
},
"type": "object",
"required": [
"id",
"action",
"user_id",
"timestamp",
"resource_type",
"resource_id",
"changes"
],
